{
  "name": "words-builder",
  "version": "1.0.0",
  "description": "Infinite Multiplayer Word World",
  "main": "client/js/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node server/tests/whitebox-logic-audit.js",
    "test:whitebox": "node server/tests/whitebox-logic-audit.js",
    "test:blackbox": "node server/tests/blackbox-ui-audit.js",
    "test:user": "node server/tests/play-like-user.js",
    "deploy": "firebase deploy",
    "deploy:hosting": "firebase deploy --only hosting",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "dev:legacy-server": "nodemon server/index.js",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@colyseus/schema": "^2.0.4",
    "@colyseus/ws-transport": "*",
    "@datastructures-js/trie": "^3.0.1",
    "@fastify/cookie": "^9.3.1",
    "@fastify/cors": "^9.0.1",
    "@libsql/client": "^0.17.4",
    "bcryptjs": "^2.4.3",
    "colyseus": "^0.15.6",
    "colyseus.js": "^0.15.25",
    "fastify": "^4.28.1",
    "firebase": "^13.1.0",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^3.3.7",
    "pixi.js": "^8.2.4"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.4",
    "playwright": "^1.64.1",
    "vite": "^8.1.4"
  }
}
